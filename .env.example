# Timeweb AI Gateway
TIMEWEB_AI_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.ai/v1

# Vision model used for building identification and search query generation.
TIMEWEB_VISION_MODEL=openai/gpt-4.1-mini

# Optional Yandex Search API reverse-image search.
# Keep false unless you explicitly want to spend Yandex Cloud budget.
YANDEX_IMAGE_SEARCH_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Upload limit
MAX_UPLOAD_MB=12
