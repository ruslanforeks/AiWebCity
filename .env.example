# Timeweb AI Gateway
TIMEWEB_AI_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.ai/v1

# Vision model used only for identification/search query generation.
TIMEWEB_VISION_MODEL=openai/gpt-4.1-mini

# Optional Yandex Search API reverse image search.
# Create an API key in Yandex AI Studio/Search API and provide your folder ID.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Safety/capacity limits
MAX_UPLOAD_MB=12
