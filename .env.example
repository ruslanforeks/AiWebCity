# Timeweb AI Gateway
TIMEWEB_AI_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.ai/v1

# Vision model used for building identification and search query generation.
TIMEWEB_VISION_MODEL=openai/gpt-4.1-mini

# Free reverse-image search layer through PicImageSearch.
# This makes requests to public Yandex Images and Google Lens endpoints.
REVERSE_SEARCH_ENABLED=true
REVERSE_SEARCH_TIMEOUT=45
REVERSE_SEARCH_RESULTS=20

# Upload limit
MAX_UPLOAD_MB=12
