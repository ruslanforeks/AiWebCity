# Timeweb AI Gateway
TIMEWEB_AI_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.ai/v1

# Vision model used for visual verification of candidates.
TIMEWEB_VISION_MODEL=openai/gpt-4.1-mini

# --- Обратный поиск (Yandex CBIR) ---------------------------------------
REVERSE_SEARCH_ENABLED=true
REVERSE_SEARCH_TIMEOUT=45
# Сколько кандидатов оставлять после текстового ранкинга.
REVERSE_SEARCH_RESULTS=60
# Запросов к Яндексу на одну фотографию: 1 = только полный кадр,
# 3 = полный кадр + два кропа объектов. Больше — выше recall и выше риск капчи.
YANDEX_MAX_PASSES=3
# Google Lens в наших тестах почти всегда возвращает 0 результатов.
GOOGLE_LENS_ENABLED=true
# Кэш ответов поиска по хэшу фото, секунды. Снижает нагрузку на Яндекс.
REVERSE_SEARCH_CACHE_TTL=900

# --- Визуальная верификация ---------------------------------------------
# Сколько кандидатов максимум показывать Vision-модели. Каждый — платный вызов.
VISUAL_CHECK_LIMIT=8
# Останавливать проверку, как только набралось столько подтверждений.
VISION_EARLY_STOP=4
# Порог, ниже которого совпадение не считается подтверждённым.
VISUAL_CONFIDENCE_THRESHOLD=0.72
# Параллельные запросы к Vision. На VPS с 1 ГБ памяти выше 3 поднимать не стоит.
VISION_CONCURRENCY=3
VISION_TIMEOUT=90
VISION_ORIGINAL_MAX_SIDE=1024
VISION_CANDIDATE_MAX_SIDE=768

# Upload limit
MAX_UPLOAD_MB=12
